{
  "name": "refrain-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "refrain": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 src/index.ts --outfile dist/refrain",
    "build:x64": "bun build --compile --minify --sourcemap --target=bun-darwin-x64 src/index.ts --outfile dist/refrain-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
