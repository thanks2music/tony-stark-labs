name = "refrain"
main = "src/index.ts"
compatibility_date = "2026-04-18"

# Workers の組み込みサブドメイン (<worker>.<subdomain>.workers.dev) は NS 委譲完了前の
# 動作確認に使うので有効のまま。必要なら deploy 後に dashboard で無効化可能。
workers_dev = true

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "refrain"

# カスタムドメインルートは NS がアクティブかつ apex の proxied な A レコードが
# 追加された後にのみ有効。無効化しておくと wrangler deploy が成功しないので
# deploy 前にコメントを外し、{DOMAIN} を実ドメインに置換してから有効化する。
# [[routes]]
# pattern = "{DOMAIN}/apps/refrain/*"
# zone_name = "{DOMAIN}"
