# OAuth credentials JSON (client_id, client_secret, refresh_token)
# 本番は Secret Manager (oauth-credentials) から自動注入される
OAUTH_CREDENTIALS='{"client_id":"","client_secret":"","refresh_token":""}'

# GCP Project ID (Cloud Functions ランタイムでは自動設定。ローカル開発時のみ必要)
GCP_PROJECT_ID=wao-event-automation

# Pub/Sub トピック名（Gmail watch() 用）
PUBSUB_TOPIC=gmail-notifications

# カレンダーID（"primary" or "xxx@group.calendar.google.com"）
# 本番は GHA secrets 経由で --set-env-vars から注入される
GOOGLE_CALENDAR_ID=primary

# Anthropic API Key（AI フォールバックパーサー用、未設定なら無効）
# 本番は Secret Manager (anthropic-api-key) から自動注入される
ANTHROPIC_API_KEY=
