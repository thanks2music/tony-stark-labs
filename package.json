{
  "name": "refrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "worker",
    "cli"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:worker": "bun run --filter worker test",
    "test:cli": "bun run --filter cli test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2"
  }
}
