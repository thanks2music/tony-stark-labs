{
  "name": "tony-stark-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Yoshiyuki Ito's personal tool monorepo",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "apps/refrain/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3",
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "turbo": "^2.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix"
    ],
    "*.{js,mjs,cjs,json,jsonc,md,yml,yaml,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
