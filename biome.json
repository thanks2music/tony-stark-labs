{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!!**/archive", "!!.husky/_", "!**/worker-configuration.d.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "yaml": {
    "formatter": { "quoteStyle": "single", "bracketSpacing": false }
  },
  "linter": {
    "rules": {
      "style": { "useImportType": "error" }
    }
  }
}
